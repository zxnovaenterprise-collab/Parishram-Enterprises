      "required": ["cardNo", "fullName"]
    },
    "payrollRecords": {
      "title": "Payroll Records",
      "description": "Stores monthly payroll records",
      "properties": {
        "id": { "type": "string" },
        "cardNo": { "type": "string" },
        "name": { "type": "string" },
        "days": { "type": "number" },
