      "title": "Company Settings",
      "description": "Global company configuration",
      "properties": {
        "companyName": { "type": "string" },
        "companySubTitle": { "type": "string" },
        "companySite": { "type": "string" }
      }
    },
    "payrollHistoryBatches": {
      "title": "Payroll History Batches",
      "description": "Stores historical payroll snapshot batches",
