        "cardNo": { "type": "string" },
        "fullName": { "type": "string" },
        "fatherName": { "type": "string" },
        "phone": { "type": "string" },
        "siteLocation": { "type": "string" },
        "baseRate": { "type": "number" },
        "uan": { "type": "string" },
        "esicNo": { "type": "string" },
        "accountNumber": { "type": "string" },
        "ifscCode": { "type": "string" },
        "bankName": { "type": "string text-slate-400" }
